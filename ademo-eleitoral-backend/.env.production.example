APP_NAME="Sistema Eleitoral ADEMO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
FRONTEND_URL=http://localhost

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT
APP_TIMEZONE=Africa/Maputo

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ademo_eleitoral
DB_USERNAME=ademo
DB_PASSWORD=change-me-strong-database-password
DB_CHARSET=utf8
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids
CACHE_STORE=database
FILESYSTEM_DISK=public

RUN_MIGRATIONS=true

REVERB_APP_ID=ademo
REVERB_APP_KEY=ademo_key
REVERB_APP_SECRET=change-me-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=80
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=30
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="ADEMO Eleitoral"
