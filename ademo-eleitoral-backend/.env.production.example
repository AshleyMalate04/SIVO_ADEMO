APP_NAME="Sistema de Votação Eleitoral ADEMO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.seu-dominio.com
FRONTEND_URL=https://seu-dominio.com
CORS_ALLOWED_ORIGINS=https://seu-dominio.com

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT
APP_TIMEZONE=Africa/Maputo
ADMIN_INITIAL_PASSWORD=change-me-strong-admin-password

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ademo_eleitoral
DB_USERNAME=ademo
DB_PASSWORD=change-me-strong-database-password
DB_CHARSET=utf8
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_EXPIRATION=480

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids
CACHE_STORE=database
FILESYSTEM_DISK=public

RUN_MIGRATIONS=false

REVERB_APP_ID=ademo
REVERB_APP_KEY=ademo_key
REVERB_APP_SECRET=change-me-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=https://seu-dominio.com
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MAIL_MAILER=smtp
# No Gmail, use o mesmo remetente em MAIL_USERNAME e MAIL_FROM_ADDRESS.
# MAIL_PASSWORD deve ser uma Palavra-passe de app, nunca a senha normal da conta.
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=30
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="ADEMO Eleitoral"
